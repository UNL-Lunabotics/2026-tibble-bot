<mujoco model="blank_scene">
    <!-- Basic visualization settings -->
    <visual>
        <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1"/>
        <map znear="0.01"/>
        <quality shadowsize="2048"/>
    </visual>

    <!-- Skybox and ground texture/material -->
    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
        <texture name="texplane" type="2d" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" width="512" height="512" mark="cross" markrgb="0.8 0.8 0.8"/>
        <material name="matplane" reflectance="0.3" texture="texplane" texrepeat="1 1" texuniform="true"/>
    </asset>

    <!-- Environment bodies -->
    <worldbody>
        <light directional="true" diffuse=".8 .8 .8" specular="0.2 0.2 0.2" pos="0 0 5" dir="0 0 -1"/>
        <geom name="floor" type="plane" size="0 0 0.05" material="matplane"/>
    </worldbody>
</mujoco>