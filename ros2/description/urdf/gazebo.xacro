<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Add any Gazebo references to links/joints including color and friction values -->
    <gazebo reference="chassis_link">
        <material>Gazebo/White</material>
    </gazebo>

    <gazebo reference="Castor">
        <material>Gazebo/Blue</material>
        <mu1 value="0.0"/>  <!-- This is friction -->
        <mu2 value="0.0"/>
    </gazebo>

    <gazebo reference="DL_Wheel">
        <material>Gazebo/SkyBlue</material>
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>0.001</mu>
                        <mu2>0.001</mu2>
                    </ode>
                </friction>
            </surface>
        </collision>
    </gazebo>

    <gazebo reference="DR_Wheel">
        <material>Gazebo/SkyBlue</material>
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>0.001</mu>
                        <mu2>0.001</mu2>
                    </ode>
                </friction>
            </surface>
        </collision>
    </gazebo>

    <gazebo reference="BLA">
        <material>Gazebo/SkyBlue</material>
        <!-- TODO: Any other configurations for Linear Actuators -->
    </gazebo>

    <gazebo reference="LA">
        <material>Gazebo/SkyBlue</material>
        <!-- TODO: Any other configurations for Linear Actuators -->
    </gazebo>

    <!-- Not sure if this is a wheel or a linear actuator -->
    <gazebo reference="TLA">
        <material>Gazebo/SkyBlue</material>
        <!-- Included in case its a wheel -->
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>0.001</mu>
                        <mu2>0.001</mu2>
                    </ode>
                </friction>
            </surface>
        </collision>
    </gazebo>

    <gazebo reference="Hopper">
        <material>Gazebo/White</material>
        <!-- TODO: Any other configurations for the Hopper -->
    </gazebo>

    <gazebo reference="Hopper_Door">
        <material>Gazebo/White</material>
        <!-- TODO: Any other configurations for the Hopper Door -->
    </gazebo>

    <gazebo reference="Hopper_Latch">
        <material>Gazebo/Purple</material>
        <!-- TODO: Any other configurations for the Hopper Latch -->
    </gazebo>

    <gazebo reference="Excavation">
        <material>Gazebo/SkyBlue</material>
        <!-- TODO: Any other configurations for Excavation -->
    </gazebo>

    <gazebo reference="FL_Wheel">
        <material>Gazebo/SkyBlue</material>
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>0.001</mu>
                        <mu2>0.001</mu2>
                    </ode>
                </friction>
            </surface>
        </collision>
    </gazebo>

    <gazebo reference="ML_Wheel">
        <material>Gazebo/SkyBlue</material>
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>0.001</mu>
                        <mu2>0.001</mu2>
                    </ode>
                </friction>
            </surface>
        </collision>
    </gazebo>

    <gazebo reference="BL_Wheel">
        <material>Gazebo/SkyBlue</material>
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>0.001</mu>
                        <mu2>0.001</mu2>
                    </ode>
                </friction>
            </surface>
        </collision>
    </gazebo>

    <gazebo reference="TL_Wheel">
        <material>Gazebo/SkyBlue</material>
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>0.001</mu>
                        <mu2>0.001</mu2>
                    </ode>
                </friction>
            </surface>
        </collision>
    </gazebo>

    <gazebo reference="FR_Wheel">
        <material>Gazebo/SkyBlue</material>
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>0.001</mu>
                        <mu2>0.001</mu2>
                    </ode>
                </friction>
            </surface>
        </collision>
    </gazebo>

    <gazebo reference="MR_Wheel">
        <material>Gazebo/SkyBlue</material>
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>0.001</mu>
                        <mu2>0.001</mu2>
                    </ode>
                </friction>
            </surface>
        </collision>
    </gazebo>

    <gazebo reference="BR_Wheel">
        <material>Gazebo/SkyBlue</material>
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>0.001</mu>
                        <mu2>0.001</mu2>
                    </ode>
                </friction>
            </surface>
        </collision>
    </gazebo>

    <gazebo reference="TR_Wheel">
        <material>Gazebo/SkyBlue</material>
